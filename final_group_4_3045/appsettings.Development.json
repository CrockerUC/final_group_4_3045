{
  //DefaultConnection: This is the name of the connection string that will be used by Entity Framework (EF) to connect to the database.
  //Server=(localdb)\MSSQLLocalDB; Tells the EF which SQL Server instance to connect to. In this case, it is the localdb instance of SQL Server.
  //Database=FinalGroup4Db; Name of the database that EF will use to store and retrieve data.
  //Trusted_Connection=True; Indicates that EF should use Windows Authentication to connect to the SQL Server instance. This means that the current Windows user credentials will be used for authentication.
  //TrustServerCertificate=True; Indicates that EF should trust the server's SSL certificate without validating it. This is useful in development environments where self-signed certificates are often used.
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=FinalGroup4Db;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
